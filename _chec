# -*- coding: utf-8 -*-
import sys
import io
if sys.platform == 'win32':
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8')

import sqlite3

print("=" * 60)
print("检查E盘数据库实际内容")
print("=" * 60)

db_path = r'E:\vnpy_data\database.db'
conn = sqlite3.connect(db_path)
cursor = conn.cursor()

# 列出所有表
cursor.execute('SELECT name FROM sqlite_master WHERE type="table"')
tables = cursor.fetchall()
print(f"\n数据库中的表:")
for t in tables:
    print(f"  - {t[0]}")

# 检查dbbardata表
print(f"\n检查dbbardata表:")
try:
    cursor.execute('SELECT COUNT(*) FROM dbbardata')
    count = cursor.fetchone()[0]
    print(f"  总记录数: {count:,}")
    
    if count > 0:
        # 按交易所统计
        cursor.execute('SELECT exchange, COUNT(DISTINCT symbol) FROM dbbardata GROUP BY exchange')
        exchanges = cursor.fetchall()
        print(f"\n  按交易所统计:")
        for ex, cnt in exchanges:
            print(f"    {ex}: {cnt} 只股票")
        
        # 显示前5条记录
        cursor.execute('SELECT symbol, exchange, datetime FROM dbbardata LIMIT 5')
        samples = cursor.fetchall()
        print(f"\n  前5条记录:")
        for s in samples:
            print(f"    {s[0]}.{s[1]} - {s[2]}")
    else:
        print(f"  [警告] 表为空！")
        
except Exception as e:
    print(f"  [错误] {e}")

conn.close()

print("\n" + "=" * 60)
