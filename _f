"""直接修复 get_pool_update_time 函数"""

# 读取文件
with open('vnpy/trader/stock_pool.py', 'r', encoding='utf-8') as f:
    lines = f.readlines()

# 找到函数并替换
in_function = False
function_start = -1
function_end = -1
indent_level = 0

for i, line in enumerate(lines):
    if 'def get_pool_update_time()' in line:
        in_function = True
        function_start = i
        continue
    
    if in_function:
        # 检查是否到了下一个函数或类定义
        if line.strip() and not line.startswith(' ') and not line.startswith('\t'):
            function_end = i
            break
        elif line.strip().startswith('def ') or line.strip().startswith('class '):
            function_end = i
            break

# 如果找到了函数
if function_start >= 0:
    if function_end < 0:
        function_end = len(lines)
    
    # 新的函数实现
    new_function = '''def get_pool_update_time() -> str:
    """获取股票池数据的更新时间（用于UI显示）"""
    try:
        cache_path = _CACHE_DIR / "symbols_cache.json"
        if cache_path.exists():
            import json
            with open(cache_path, 'r', encoding='utf-8') as f:
                data = json.load(f)
                return data.get('update_time', '')
    except Exception:
        pass
    return ""

'''
    
    # 替换函数
    new_lines = lines[:function_start] + [new_function] + lines[function_end:]
    
    # 写回文件
    with open('vnpy/trader/stock_pool.py', 'w', encoding='utf-8') as f:
        f.writelines(new_lines)
    
    print("✓ 成功修复 get_pool_update_time 函数")
    print(f"  - 替换了第 {function_start+1} 到 {function_end} 行")
    print("  - 使用缓存路径: _CACHE_DIR / 'symbols_cache.json'")
else:
    print("× 未找到 get_pool_update_time 函数")
